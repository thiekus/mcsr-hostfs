// Midnight Club: Street Racing (NTSC/US) HostFS unpacked patch
// Patched by Thiekus 2026

gametitle=Midnight Club - Street Racing (NTSC/US)

[HostFS Unpacked]
description=Enable HostFS with unpacked data
author=Thiekus

// Force use coreFileStandard on zipFile::InitInternal
// addiu v1,v1,0x3340 => addiu v1,v1,0x56a8
patch=3,EE,00281264,word,246356a8

// NOP to avoid iopManager::sm_ModuleLocation set to 1
// This enforce module to be load by host0: instead hardcoded cdrom0:
patch=3,EE,0029ebf8,word,00000000

// Disable /mcassets/shop path prefix on host0:
patch=3,EE,0030c980,byte,00 // terminate with null at beginning

// Replace aud/music/ path to music/ just like in original game CD
// Because dev location of music is inside aud dir rather than root dir
patch=3,EE,0031e758,byte,6D // m
patch=3,EE,0031e759,byte,75 // u
patch=3,EE,0031e75a,byte,73 // s
patch=3,EE,0031e75b,byte,69 // i
patch=3,EE,0031e75c,byte,63 // c
patch=3,EE,0031e75d,byte,2F // /
patch=3,EE,0031e75e,byte,00 // \0

// While these patches above is required to HostFS works
// These bottom patches is more likely for more consistency with HostFS

// Put ":" to fit into "host0:" prefix instead of "cdrom0:"
// lb v1, 0x0006 => lb v1, 0x0005
patch=3,EE,002a6f1c,word,80830005

// Swap between / => \ to \ => /
// li a1, 0x2f => li a1, 0x5f
patch=3,EE,002a6f40,word,2405005c
// li a0, 0x5f => li a0, 0x2f
patch=3,EE,002a6f44,word,2404002f

// NOP at appending ";1\0" suffix
patch=3,EE,002a6f94,word,00000000
patch=3,EE,002a6f98,word,00000000
patch=3,EE,002a6f9c,word,00000000
patch=3,EE,002a6fa0,word,00000000

// Patch to avoid read *.zip files
// bne v0,zero,LAB_00100574 => j 0x100574
patch=3,EE,00100528,word,0804015d
patch=3,EE,0010052c,word,00000000

// Force load hardcoded IOP from host0 instead of cdrom0
// Not required but maybe need to quick replace?
patch=3,EE,003244a8,byte,68 // h
patch=3,EE,003244a9,byte,6F // o
patch=3,EE,003244aa,byte,73 // s
